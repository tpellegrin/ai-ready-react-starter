# Application configuration (validated by src/config/schema.ts).
#
# VITE_* values are inlined into the public JavaScript bundle at build time.
# Never put secrets here. Changing a value requires a rebuild.
#
# Committed per-mode defaults: .env.development (pnpm start), .env.test
# (Vitest), .env.storybook (Storybook), .env.production (pnpm build)
# and, in the starter, .env.demo (pnpm build:demo).
# Override locally in .env.local / .env.[mode].local (gitignored) or with
# environment variables in CI/CD. See docs/configuration.md.

# Display name.
VITE_APP_NAME=React Starter

# API origin or root-relative path. Required. Production builds require
# https:// (http only for localhost) unless demo mode is on.
VITE_API_BASE_URL=https://api.example.com

# AuthAdapter wired by src/containers/composition/createAuthAdapter.ts:
#   session - HTTP cookie session (src/auth/adapters/session)
# starter:demo-start
#   demo    - demo adapter that signs in anyone (requires VITE_DEMO_MODE=true)
# starter:demo-end
VITE_AUTH_PROVIDER=session

# Demo/preview build: allows mocks in a production build (preview deployments).
# starter:demo-start
# In the starter it also enables demo auth, the DemoHub start page and the
# public onboarding preview.
# starter:demo-end
VITE_DEMO_MODE=false

# Start the MSW browser worker (reference API). Not allowed in production
# builds unless VITE_DEMO_MODE=true.
VITE_ENABLE_MOCKS=false
