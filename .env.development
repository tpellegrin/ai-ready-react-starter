# `pnpm start`: local development against the in-browser mock API (MSW).
VITE_APP_NAME=React Starter
VITE_API_BASE_URL=/api
# starter:demo-start
VITE_AUTH_PROVIDER=demo
VITE_DEMO_MODE=true
# starter:demo-else
# VITE_AUTH_PROVIDER=session
# VITE_DEMO_MODE=false
# starter:demo-end
VITE_ENABLE_MOCKS=true
