// Tooling that runs in Node: Vite/Vitest/Playwright/Storybook configs, repo
// scripts (JS checked via JSDoc) and end-to-end tests.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.design.config.ts",
    "capacitor.config.ts",
    ".storybook/main.ts",
    ".storybook/vite.config.ts",
    "scripts/**/*.mjs",
    "e2e/**/*.ts"
  ],
  "exclude": [
    "scripts/architecture/fixtures/**",
    "scripts/architecture/support/**",
    "scripts/templates/**"
  ]
}
