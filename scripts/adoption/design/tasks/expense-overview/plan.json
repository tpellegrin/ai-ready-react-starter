  "title": "Expenses page",
  "request": {
    "summary": "Build the Expenses page of Ledgerly from the attached sketches: the team sees what was spent, filters by status and adds an expense.",
    "requirements": [
      {
        "id": "req-list",
        "text": "Signed-in people see the team's expenses with description, category, date, amount and status."
      },
      {
        "id": "req-add",
        "text": "People can add an expense (description, amount, category); new expenses start as pending."
      },
      {
        "id": "req-filter",
        "text": "The list can be filtered by status, and the filter can be shared as a link."
      },
      {
        "id": "req-nav",
        "text": "The page is reachable from the main navigation."
      }
    ]
  },
