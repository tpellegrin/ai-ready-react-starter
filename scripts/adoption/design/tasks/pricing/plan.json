  "title": "Pricing page",
  "request": {
    "summary": "Build the public pricing page of Ledgerly from the designer's high-fidelity desktop and mobile exports, using the product's components and theme.",
    "requirements": [
      {
        "id": "req-plans",
        "text": "Show the three plans (Starter, Team, Business) with price, short description and what each includes."
      },
      {
        "id": "req-yearly",
        "text": "Yearly billing costs ten months (two months free): show the monthly equivalent and the yearly total when Yearly is chosen."
      },
      {
        "id": "req-cta",
        "text": "Starter and Team start at sign-in; Business contacts sales by email (sales@ledgerly.example)."
      }
    ]
  },
