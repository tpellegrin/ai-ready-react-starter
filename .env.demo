# `pnpm build:demo`: an explicitly labelled demo/preview build (e.g. the
# starter's GitHub Pages site). Demo auth signs in anyone and the API is served
# by MSW inside the browser. Never deploy this mode as a real product.
VITE_APP_NAME=React Starter (demo)
VITE_API_BASE_URL=/api
VITE_AUTH_PROVIDER=demo
VITE_DEMO_MODE=true
VITE_ENABLE_MOCKS=true
