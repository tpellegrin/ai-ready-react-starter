# `pnpm build`: a real deployment. Demo auth and mocks are off.
# VITE_API_BASE_URL is intentionally unset: provide it from your deployment
# environment (or .env.production.local) or the build fails with a clear error.
VITE_APP_NAME=React Starter
VITE_AUTH_PROVIDER=session
VITE_DEMO_MODE=false
VITE_ENABLE_MOCKS=false
