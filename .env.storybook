# Storybook (component catalog). Stories that fetch use the MSW reference API,
# so the msw/vite plugin serves and emits the worker script.
VITE_APP_NAME=React Starter
VITE_API_BASE_URL=/api
# starter:demo-start
VITE_AUTH_PROVIDER=demo
VITE_DEMO_MODE=true
# starter:demo-else
# VITE_AUTH_PROVIDER=session
# VITE_DEMO_MODE=false
# starter:demo-end
VITE_ENABLE_MOCKS=true
