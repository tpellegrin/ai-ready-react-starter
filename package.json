{
  "name": "react-boilerplate",
  "description": "Professional React 19 + Vite + TypeScript boilerplate with a focus on architecture and performance",
  "private": true,
  "version": "1.0.0-rc.1",
  "author": "Boilerplate Authors",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "start": "vite --host localhost --port 3000 --open",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "prepare": "husky install",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/i18n-check.mjs && node scripts/i18n-pseudo.mjs --check",
    "test": "vitest --project unit",
    "test:run": "vitest run --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:tooling": "vitest run --project tooling",
    "validate": "node scripts/verify.mjs --group validate",
    "i18n:pseudo": "node scripts/i18n-pseudo.mjs",
    "arch:check": "node scripts/architecture/check.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "build:demo": "vite build --mode demo",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --quiet -o storybook-static",
    "test:storybook": "vitest run --project storybook",
    "check:build": "node scripts/check-build.mjs",
    "check:build:demo": "node scripts/check-build.mjs --profile demo",
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/check-generator.mjs",
    "catalog": "node scripts/catalog.mjs",
    "test:e2e": "playwright test",
    "adopt": "node scripts/adopt.mjs",
    "adopt:check": "node scripts/check-adoption.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.4",
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@tanstack/react-query": "^5.100.9",
    "modern-normalize": "^3.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.90.0",
    "react-router-dom": "^7.18.4",
    "react-transition-group": "^4.4.5",
    "styled-components": "^6.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/react-transition-group": "^4.4.12",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser-playwright": "~4.1.12",
    "@vitest/coverage-v8": "~4.1.12",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^10.6.3",
    "globals": "^16.3.0",
    "husky": "^8.0.0",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.1.5",
    "msw": "^3.0.3",
    "playwright": "1.64.1",
    "postcss-styled-syntax": "^0.7.1",
    "prettier": "^3.6.2",
    "storybook": "^10.6.3",
    "stylelint": "^16.23.1",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard": "^39.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-use-logical": "^2.1.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "~4.1.12"
  },
  "pnpm": {
    "overrides": {
      "handlebars@<4.7.10": "4.7.10"
    }
  }
}
